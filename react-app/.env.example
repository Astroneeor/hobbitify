# Copy this file to `.env.local` for local dev. `.env*` files are gitignored.
# Vite bakes `VITE_*` into the client bundle at build time — set them in
# Cloudflare Pages -> Settings -> Environment Variables for production.

# Cloudflare Worker base URL (no trailing path). Local: wrangler dev default port.
VITE_BACKEND_URL=http://localhost:8787

# Cloudflare Turnstile site key (public; safe in the browser).
# Test keys (dev only):
#   1x00000000000000000000AA  -> always passes (visible widget)
#   2x00000000000000000000AB  -> always blocks
#   3x00000000000000000000FF  -> forces interaction
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Supabase (Project Settings -> API). The anon key is safe in the browser; RLS
# enforces per-user access. Never put the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
